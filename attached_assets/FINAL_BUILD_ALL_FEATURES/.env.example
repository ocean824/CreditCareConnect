# === Core ===
DATABASE_URL=postgres://user:pass@host:port/dbname
REPLIT_DOMAINS=localhost
REPL_ID=your-replit-app-id
SESSION_SECRET=change_me_at_least_16_chars
PORT=5000
FILES_DIR=files

# Comma-separated admin emails; seed & runtime promote to admin
ADMIN_EMAILS=admin@example.com

# === Providers ===
OPENAI_API_KEY=sk-xxxx
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CLICK2MAIL_API_KEY=

# Test-only header auth (for vitest/supertest). 1 = enabled for tests
TEST_AUTH=0
